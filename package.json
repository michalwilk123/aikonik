{
  "name": "aikonik",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "bun run test:pure && bun run test:integration",
    "test:pure": "bun test ./tests/pure",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "knip": "knip",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts",
    "build:cloudflare": "bun scripts/build-cloudflare.ts",
    "preview": "bun run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "bun run build:cloudflare && opennextjs-cloudflare deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hubmi --local",
    "db:migrate:remote": "wrangler d1 migrations apply hubmi --remote",
    "test:integration": "for f in tests/integration/*.test.ts; do bun test --timeout 30000 \"$f\" || exit 1; done",
    "eval:openrouter": "bun run evals/openrouter.ts",
    "cms:seed": "bun scripts/seed-staff.ts",
    "test:browser": "bun tests/browser/submission-flow.ts",
    "test:browser:requests": "bun tests/browser/request-conversation-flow.ts",
    "test:browser:request-demo": "bun tests/browser/request-demo-flow.ts",
    "test:browser:grants": "bun tests/browser/grant-workflow.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@delmaredigital/payload-better-auth": "^0.13.1",
    "@opennextjs/cloudflare": "^1.20.8",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@payloadcms/db-d1-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "ai": "^7.0.127",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "graphql": "^16.8.1",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.32.0",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.39.0",
    "miniflare": "^5.20261001.0-alpha",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.147.0"
  },
  "packageManager": "bun@1.3.6",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
